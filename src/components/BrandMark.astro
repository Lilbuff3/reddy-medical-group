---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<a class:list={['brand', { compact }]} href="#top" aria-label="Reddy Medical Group home">
  <span class="brand-mark" aria-hidden="true">
    <svg viewBox="0 0 32 32" fill="none"><path d="M16 4v24M4 16h24" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/><circle cx="16" cy="16" r="11.2" stroke="currentColor" stroke-width="1.2" opacity=".65"/></svg>
  </span>
  <span class="brand-copy">
    <span class="brand-name">Reddy Medical Group</span>
    <span class="brand-meta">Fresno, California</span>
  </span>
</a>
